{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "walkwalkddog",
          "appId": "1:701057110809:android:61d3ecd893ab595d9a2b88",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "walkwalkddog",
          "appId": "1:701057110809:ios:ece40fa68f5eac209a2b88",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "walkwalkddog",
          "configurations": {
            "android": "1:701057110809:android:61d3ecd893ab595d9a2b88",
            "ios": "1:701057110809:ios:ece40fa68f5eac209a2b88",
            "web": "1:701057110809:web:5e7fc1686b8d49ed9a2b88"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
