rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 본인만 읽기/쓰기
    // subscription 필드는 클라이언트 쓰기 차단 (Cloud Functions Admin SDK만 가능)
    // 허용 필드 화이트리스트로 예기치 않은 필드 주입 방지
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // 클라이언트가 쓸 수 있는 필드 목록
      function hasOnlyAllowedFields() {
        let allowed = ['displayName', 'photoURL', 'dogName',
          'dogBreed', 'settings', 'createdAt', 'updatedAt'];
        return request.resource.data.keys().hasOnly(
          allowed.concat(resource == null ? [] : resource.data.keys().toList())
        );
      }

      allow read: if isOwner();

      // 신규 문서: subscription 필드 포함 불가
      allow create: if isOwner()
        && !request.resource.data.keys().hasAny(['subscription']);

      // 기존 문서 수정: subscription 필드 변경 불가
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);

      // 문서 삭제: 본인만 가능
      allow delete: if isOwner();
    }

    // 프리미엄 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /imageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 무료 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /freeImageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 채팅 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /chatUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 모니터링 데이터: 클라이언트 접근 차단 (Admin SDK만 가능)
    match /monitoring/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // AI 결과물 신고 (Phase 27 — Google Play 생성형 AI 정책 / Apple 1.2)
    // 로그인 사용자는 신고 접수(create)만 가능. 열람·수정·삭제는 운영자(Admin SDK) 전용.
    // 다른 사용자의 신고를 읽을 수 없어야 하므로 read도 차단한다.
    match /contentReports/{reportId} {
      function isValidReport() {
        let data = request.resource.data;
        return data.keys().hasOnly(
            ['uid', 'reason', 'contentType', 'provider', 'createdAt'])
          && data.uid == request.auth.uid
          && data.reason is string
          && data.reason.size() <= 40
          && data.contentType is string
          && data.contentType.size() <= 20;
      }

      allow create: if request.auth != null && isValidReport();
      allow read, update, delete: if false;
    }

    // 기본: 모든 접근 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
