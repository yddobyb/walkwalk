rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 본인만 읽기/쓰기
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 구독 정보: 클라이언트는 읽기만, 쓰기는 Cloud Functions만
      match /subscription {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // 프리미엄 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /imageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 무료 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /freeImageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 모니터링 데이터: 인증된 사용자 읽기 전용
    match /monitoring/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 기본: 모든 접근 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
