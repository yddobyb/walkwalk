rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필: 본인만 읽기. **클라이언트 쓰기는 전면 차단.**
    //
    // 클라이언트에는 users/{uid} 쓰기 경로가 아예 없다 —
    // 등급 조회(user_tier_service)가 읽기만 하고, 구독 정보는
    // syncSubscription 함수가 Admin SDK로 기록한다(규칙 우회).
    // 따라서 쓰기를 열어둘 이유가 없고, 닫으면 필드 주입·구독 위조
    // 가능성이 원천 차단된다.
    //
    // ⚠️ 이전 버전은 필드 화이트리스트 함수를 정의만 하고 **호출하지 않아**
    // 임의 필드 쓰기가 통과했다(20KB junk 주입이 200으로 성공). 화이트리스트
    // 방식은 유지 비용이 있고 같은 실수가 반복되기 쉬워 전면 차단으로 바꿨다.
    // 나중에 클라이언트 쓰기가 필요해지면 여기서 permission-denied가 나므로
    // 규칙을 함께 고치도록 강제된다(fail-closed).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 프리미엄 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /imageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 무료 이미지 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /freeImageUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 채팅 사용량: 본인만 읽기, 쓰기는 Cloud Functions만
    match /chatUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 모니터링 데이터: 클라이언트 접근 차단 (Admin SDK만 가능)
    match /monitoring/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // AI 결과물 신고 (Phase 27 — Google Play 생성형 AI 정책 / Apple 1.2)
    // 로그인 사용자는 신고 접수(create)만 가능. 열람·수정·삭제는 운영자(Admin SDK) 전용.
    // 다른 사용자의 신고를 읽을 수 없어야 하므로 read도 차단한다.
    match /contentReports/{reportId} {
      function isValidReport() {
        let data = request.resource.data;
        return data.keys().hasOnly(
            ['uid', 'reason', 'contentType', 'provider', 'createdAt'])
          && data.uid == request.auth.uid
          && data.reason is string
          && data.reason.size() <= 40
          && data.contentType is string
          && data.contentType.size() <= 20;
      }

      allow create: if request.auth != null && isValidReport();
      allow read, update, delete: if false;
    }

    // 기본: 모든 접근 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
