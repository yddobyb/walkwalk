# WalkDog Firebase Functions - Environment Configuration Template
# 이 파일을 복사하여 실제 값을 입력하세요 (로컬 개발용)

# Gemini API Configuration
GEMINI_API_KEY=AIzaSy...  # Google AI Studio에서 발급받은 API 키
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent

# Rate Limits
DAILY_QUOTA=20              # 프로젝트 전체 일일 생성 목표
RATE_LIMIT_PER_5MIN=3       # 사용자당 5분당 최대 요청 수

# 주의사항:
# 1. 이 파일을 복사하여 .env 파일을 만들지 마세요
# 2. Firebase Functions는 firebase functions:config:set 으로 설정합니다
# 3. 로컬 테스트는 .runtimeconfig.json을 사용합니다 (firebase functions:config:get > .runtimeconfig.json)
