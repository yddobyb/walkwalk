<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Walk Dog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>walk_dog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_dartobservatory._tcp</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>WalkDog needs to read your step count data from Apple Health to accurately track your daily walking activity and provide personalized pet interactions.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>WalkDog may write step data to Apple Health to keep your health information up to date.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>WalkDog needs local network access for debugging purposes during development.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>WalkDog uses location data to detect outdoor walks and provide bonus rewards for outdoor activities.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>WalkDog uses location data to detect outdoor walks and provide bonus rewards for outdoor activities.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WalkDog uses location data to detect outdoor walks and provide bonus rewards for outdoor activities.</string>
	<key>NSMotionUsageDescription</key>
	<string>WalkDog uses motion data to track your steps and provide personalized pet interactions based on your walking activity.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>background-processing</string>
		<string>background-fetch</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
